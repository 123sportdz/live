SOURCE_URL=https://www.youtube.com/channel/UCFmnqispHbyVZKRM6RcybWQ/live
SOURCE_PLATFORM=auto
# حقوق المصدر: owned (تملكه) | licensed (ترخيص) | third_party (بث قناة أخرى) | unknown
SOURCE_RIGHTS=unknown
# أساس الحقوق (إذن/ترخيص/ملكية) — يُحفظ في ملف الحلقة وسجل الجلسة
SOURCE_RIGHTS_NOTE=
# مستوى الإنتاج: raw (نقل مباشر) | branded (شعار/إطار) | editorial (تعليق وفصول ومقدمة أصلية)
TRANSFORM_LEVEL=branded
# هل يحمل المصدر موسيقى لا تملك حقوقها؟
SOURCE_THIRD_PARTY_MUSIC=false
LIVE_PLATFORMS=youtube,facebook
YTDLP_FORMAT=b[height<=720]/bv*[height<=720]+ba/best
YTDLP_COOKIE_FILE=
YTDLP_COOKIES_FROM_BROWSER=
PIPE_MODE=false
FFMPEG=
FFMPEG_PRESET=veryfast

YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_MODE=auto
# مفتاح البث الثابت (وضع static فقط). اتركه فارغاً عند استخدام OAuth.
YOUTUBE_STREAM_KEY=
# ربط YouTube بدون متصفح (للخوادم البعيدة): فعّل الخيار ثم اتبع الخطوات من لوحة التحكم
YOUTUBE_MANUAL_AUTH=false
YOUTUBE_MANUAL_AUTH_CODE=
YOUTUBE_PRIVACY_STATUS=public
# التصنيف 25 = أخبار وسياسة، وهو الأنسب لقناة إخبارية
YOUTUBE_CATEGORY_ID=25
YOUTUBE_MADE_FOR_KIDS=false
YOUTUBE_DEFAULT_LANGUAGE=ar
YOUTUBE_TITLE_OVERRIDE=
YOUTUBE_DESCRIPTION_OVERRIDE=
YOUTUBE_TAGS_OVERRIDE=
YOUTUBE_BACKUP=false

FACEBOOK_ACCESS_TOKEN=
FACEBOOK_TARGET_ID=me
FACEBOOK_STREAM_KEY=
FACEBOOK_GRAPH_VERSION=v26.0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_METADATA_ENABLED=true
GEMINI_THUMBNAIL_ENABLED=true
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# صورة المصغّرة: auto (Gemini ثم محلي) | local | gemini | off
THUMBNAIL_MODE=auto
# اسم القناة الظاهر على الغلاف
BRAND_NAME=Oussama News
METADATA_LANGUAGE=ar
# إعادة صياغة محلية للعنوان والوصف والكلمات عند غياب Gemini (true/false)
SEO_REWRITE=true

# إشعارات فورية (اختياري): تيليجرام عبر بوت + Webhook عام لكل الأحداث
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=
NOTIFY_WEBHOOK_URL=
# لغة نصوص الإشعارات: ar أو en
NOTIFY_LANGUAGE=ar

# أرشفة كل جلسة بث إلى ملف MP4 في مجلد الحالة (recordings/)
RECORD_ENABLED=false
# حذف التسجيلات الأقدم من N يوماً (0 = بلا حد) وسقف الحجم بالغيغابايت (0 = بلا حد)
RECORDING_RETENTION_DAYS=14
RECORDING_MAX_GB=0

LOGO_ENABLED=true
LOGO_FILE=
LOGO_POSITION=bottom-right
LOGO_SIZE_PERCENT=12
LOGO_OPACITY=0.9
FRAME_ENABLED=false
FRAME_FILE=

INITIAL_PROFILE=720p
ADAPTIVE_QUALITY=true
RECONNECT_DELAY=5
SOURCE_RETRY=30
STALL_TIMEOUT=45
HEARTBEAT=30
SOURCE_END_GRACE=180
LOG_LEVEL=INFO
LIVE_RELAY_STATE_DIR=
